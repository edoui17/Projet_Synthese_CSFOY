@page "/profile/{Pseudonyme}"
@using Core.Domain
@inject HttpClient Http
@rendermode InteractiveServer

<header>
    <nav id="navbar">
        <div>
            <div class="profile">
                <img src="images/profile/Avatars_06.png" alt="profile picture">
            </div>

            <span style="color: white; font-size: 24px; font-weight: bold; font-family: 'Pixelify Sans', sans-serif;">@Pseudonyme.ToUpper()</span>
        </div>
        <a href="/">
            <img src="images/logo.png" alt="Logo Island Survivor" id="logo">
        </a>
        <h2 class="headerNiv">Lvl @HighestLevel</h2>
    </nav>
</header>

<section>
    <div style="height:500px;scrollbar-base-color:gold;overflow:auto;" class="rank">
        @if (m_isLoading)
        {
            <p style="color: white; text-align: center;">Chargement du profil...</p>
        }
        else if (m_profile == null)
        {
            <p style="color: white; text-align: center;">Joueur introuvable.</p>
        }
        else if (m_profile.LastSessions == null || !m_profile.LastSessions.Any())
        {
            <p style="color: white; text-align: center;">Aucune partie enregistrée.</p>
        }
        else
        {
            var sessionsList = m_profile.LastSessions.OrderByDescending(s => s.PlayedAt).ToList();

            foreach (var session in sessionsList)
            {
                <div class="solo" style="margin-bottom: 20px;">
                    <img src="images/solobar.png" alt="rank bar">
                    <h3>@session.PlayedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") - Lvl @session.LevelReached</h3>
                    <h2>
                        <span style="font-size: 14px; margin-right: 15px;">Temps: @session.Duration.ToString(@"hh\:mm\:ss")</span>
                        <span style="font-size: 14px; margin-right: 15px;">Score: @session.Score</span>
                        <span style="font-size: 14px; margin-right: 15px;">Vie: @session.Health</span>
                        <span style="font-size: 14px; margin-right: 15px;">Attaque: @session.Attack</span>
                        <span style="font-size: 14px; margin-right: 15px;">Vitesse: @session.Speed</span>
                        <span style="font-size: 14px;">Chance: @session.Luck</span>
                    </h2>
                </div>
            }
        }
    </div>
</section>

@code {
    [Parameter]
    public string Pseudonyme { get; set; } = string.Empty;

    private ProfileResponse? m_profile;
    private bool m_isLoading = true;

    private int HighestLevel => m_profile?.LastSessions?.Any() == true
        ? m_profile.LastSessions.Max(s => s.LevelReached)
        : 1;

    /*protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }*/

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProfileAsync();
            StateHasChanged();
        }
    }

    private async Task LoadProfileAsync()
    {
        m_isLoading = true;
        try
        {
            m_profile = await Http.GetFromJsonAsync<ProfileResponse>($"api/player/profile/{Pseudonyme}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching profile: {ex.Message}");
            m_profile = null;
        }
        finally
        {
            m_isLoading = false;
        }
    }
}
