@page "/"
@using Core.Domain
@using System.Timers
@implements IDisposable
@inject HttpClient Http
@rendermode InteractiveServer

<style>
    .spinning {
        animation: rotation 1s infinite linear !important;
        transform-origin: center center;
    }

    @@keyframes rotation {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(359deg);
        }
    }
</style>

<header>
    <nav id="navbar">
        <div>
            <div class="profile">
                <img src="images/profile/Avatars_06.png" alt="profile picture">
            </div>

            <a href="/login">Se connecter</a>
        </div>
        <img src="images/logo.png" alt="Logo Island Survivor" id="logo">
        <h2 class="headerNiv"></h2>
    </nav>
</header>

<section>
    <div>
        <div id="searchBar">
            <input type="search" id="site-search" name="q" @bind="SearchQuery" @bind:event="oninput" placeholder="Chercher un joueur..." />
        </div>
        <div class="sortAndRefresh">
            <button id="refreshButton" @onclick="RefreshLeaderboard" disabled="@m_isRefreshing">
                <img src="images/refreshbutton1.png" alt="Rafraîchir le classement" class="@(m_isRefreshing ? "spinning" : "")">
            </button>
            <div id="sortRank">
                <select name="ranks" id="rank-select" @bind="SortCriteria">
                    <option value="Level">Level</option>
                    <option value="Temps">Temps</option>
                    <option value="Vie">Vie</option>
                    <option value="Chance">Chance</option>
                    <option value="Attaque">Attaque</option>
                    <option value="Vitesse">Vitesse</option>
                    <option value="No stat">No stat</option>
                </select>
            </div>
        </div>
    </div>

    <div style="height:500px;scrollbar-base-color:gold;overflow:auto;" class="rank">
        @if (m_players == null)
        {
            <p style="color: white; text-align: center;">Chargement du classement...</p>
        }
        else if (!FilteredAndSortedPlayers.Any())
        {
            <p style="color: white; text-align: center;">Aucun joueur trouvé.</p>
        }
        else
        {
            var playersList = FilteredAndSortedPlayers.ToList();
            var totalPlayers = playersList.Count;

            if (totalPlayers == 1)
            {
                var entry = playersList[0];
                <div class="solo">
                    <img src="images/solobar.png" alt="rank bar">
                    <h3>@entry.Rank. @entry.Entry.Username.ToUpper()</h3>
                    <h2>@GetStatDisplay(entry.Entry)</h2>
                </div>
            }
            else
            {
                for (int i = 0; i < totalPlayers; i++)
                {
                    var entry = playersList[i];
                    string barImage = "images/rankMiddleBar2.png";
                    string cssClass = "middle";

                    if (i == 0) { barImage = "images/ranktopbar.png"; cssClass = "top"; }
                    else if (i == totalPlayers - 1) { barImage = "images/rankBarBottom2.png"; cssClass = "bottom"; }

                    <div class="@cssClass">
                        <img src="@barImage" alt="rank bar">
                        <h3>@entry.Rank. @entry.Entry.Username.ToUpper()</h3>
                        <h2>@GetStatDisplay(entry.Entry)</h2>
                    </div>
                }
            }
        }
    </div>
</section>

@code {
    private IEnumerable<PlayerLeaderboardEntry>? m_players;
    private string m_searchQuery = string.Empty;
    private string m_sortCriteria = "Level";
    private bool m_isRefreshing = false;
    private System.Timers.Timer? m_refreshTimer;
    private const double REFRESH_INTERVAL = 3600000; // 1 hour in milliseconds

    public string SearchQuery
    {
        get => m_searchQuery;
        set
        {
            m_searchQuery = value;
        }
    }

    public string SortCriteria
    {
        get => m_sortCriteria;
        set
        {
            m_sortCriteria = value;
        }
    }

    private IEnumerable<(int Rank, PlayerLeaderboardEntry Entry)> FilteredAndSortedPlayers
    {
        get
        {
            if (m_players == null) return Array.Empty<(int, PlayerLeaderboardEntry)>();

            IEnumerable<PlayerLeaderboardEntry> playersToFilter = m_players;

            if (SortCriteria == "No stat")
            {
                playersToFilter = playersToFilter.Where(p => p.BonusHealth == 0 && p.BonusAttack == 0 && p.BonusSpeed == 0 && p.BonusLuck == 0);
            }

            var sorted = SortCriteria switch
            {
                "Level" => playersToFilter.OrderByDescending(p => p.Level),
                "Temps" => playersToFilter.OrderByDescending(p => p.Level).ThenBy(p => p.Duration),
                "Vie" => playersToFilter.OrderByDescending(p => p.Health),
                "Chance" => playersToFilter.OrderByDescending(p => p.Luck),
                "Attaque" => playersToFilter.OrderByDescending(p => p.Attack),
                "Vitesse" => playersToFilter.OrderByDescending(p => p.Speed),
                "No stat" => playersToFilter.OrderByDescending(p => p.Level),
                _ => playersToFilter.OrderByDescending(p => p.Level)
            };

            var ranked = sorted.Select((p, index) => (Rank: index + 1, Player: p));

            if (!string.IsNullOrWhiteSpace(SearchQuery))
                ranked = ranked.Where(r => r.Player.Username.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));

            return ranked;
        }
    }

    private string GetStatDisplay(PlayerLeaderboardEntry player)
    {
        return SortCriteria switch
        {
            "Temps" => $"{player.Duration:hh\\:mm\\:ss} - {player.Score} pts",
            "Vie" => $"Lvl {player.Level} - {player.Health} Vie",
            "Chance" => $"Lvl {player.Level} - {player.Luck} Chance",
            "Attaque" => $"Lvl {player.Level} - {player.Attack} Attaque",
            "Vitesse" => $"Lvl {player.Level} - {player.Speed} Vitesse",
            _ => $"Lvl {player.Level}"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaderboardAsync();
        StartRefreshTimer();
    }

    private void StartRefreshTimer()
    {
        m_refreshTimer?.Dispose();
        m_refreshTimer = new System.Timers.Timer(REFRESH_INTERVAL);
        m_refreshTimer.Elapsed += async (sender, e) => await InvokeAsync(async () => await LoadLeaderboardAsync());
        m_refreshTimer.AutoReset = true;
        m_refreshTimer.Enabled = true;
    }

    public void Dispose()
    {
        m_refreshTimer?.Dispose();
    }

    private async Task RefreshLeaderboard()
    {
        StartRefreshTimer(); // Reset timer to avoid double refresh
        await LoadLeaderboardAsync();
    }

    private async Task LoadLeaderboardAsync()
    {
        if (m_isRefreshing) return;

        m_isRefreshing = true;
        StateHasChanged();


        await Task.Delay(500); // Ajout d'un délai pour garantir le rendu de l'animation CSS avant l'appel API


        try
        {
            m_players = await Http.GetFromJsonAsync<IEnumerable<PlayerLeaderboardEntry>>("api/player/leaderboard");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching leaderboard: {ex.Message}");
            m_players ??= new List<PlayerLeaderboardEntry>();
        }
        finally
        {
            m_isRefreshing = false;
            StateHasChanged();
        }
    }
}
