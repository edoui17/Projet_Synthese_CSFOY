@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Web.Services
@using System.Security.Claims
@using Core.Domain
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject ILogger<Dashboard> Logger
@rendermode InteractiveServer

<PageTitle>Dashboard - Island Survivor</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-3">
                    <h3 class="mb-0"><i class="bi bi-speedometer2"></i> Island Survivor - Dashboard</h3>
                    <button class="btn btn-outline-light btn-sm" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </div>
                <div class="card-body p-4">
                    <AuthorizeView>
                        <Authorized>
                            @if (m_isLoading)
                            {
                                <div class="text-center my-5">
                                    <div class="spinner-border text-success" style="width: 3rem; height: 3rem;" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-3 text-muted fw-bold">Récupération de vos données de survie...</p>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(m_errorMessage))
                            {
                                <div class="alert alert-danger shadow-sm" role="alert">
                                    <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Oups !</h4>
                                    <p>@m_errorMessage</p>
                                    <hr>
                                    <div class="d-flex justify-content-end">
                                        <button class="btn btn-danger btn-sm" @onclick="LoadProfile">
                                            <i class="bi bi-arrow-clockwise"></i> Réessayer la connexion
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (m_profile != null)
                            {
                                <div class="row mb-4 align-items-center">
                                    <div class="col-md-7">
                                        <h2 class="display-6">Salut, <strong>@m_profile.Username</strong> !</h2>
                                        <p class="lead text-muted mb-0">Prêt pour votre prochaine expédition ?</p>
                                    </div>
                                    <div class="col-md-5 text-md-end mt-3 mt-md-0">
                                        <div class="card bg-primary text-white border-0 shadow-sm mb-2">
                                            <div class="card-body py-2">
                                                <h5 class="card-title mb-0">Record Personnel : <strong>@m_profile.HighScore pts</strong></h5>
                                            </div>
                                        </div>
                                        <div class="badge bg-light text-dark border p-2">
                                            <i class="bi bi-clock-history"></i> Dernière synchronisation : <strong>@m_profile.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-4">

                                <div class="row mb-5">
                                    <div class="col-12">
                                        <h5 class="mb-3 text-success"><i class="bi bi-star-fill"></i> Statistiques de votre Meilleure Session</h5>
                                        <div class="card border-0 shadow-sm bg-light">
                                            <div class="card-body">
                                                <div class="row text-center">
                                                    @{
                                                        var bestSession = m_profile.LastSessions.FirstOrDefault();
                                                    }
                                                    <div class="col-6 col-md-3 mb-3 mb-md-0">
                                                        <div class="text-uppercase text-muted small fw-bold">Santé</div>
                                                        <div class="h2 mb-0">@(bestSession?.Health.ToString("F1") ?? "0.0")</div>
                                                    </div>
                                                    <div class="col-6 col-md-3 mb-3 mb-md-0">
                                                        <div class="text-uppercase text-muted small fw-bold">Attaque</div>
                                                        <div class="h2 mb-0">@(bestSession?.Attack.ToString("F1") ?? "0.0")</div>
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <div class="text-uppercase text-muted small fw-bold">Vitesse</div>
                                                        <div class="h2 mb-0">@(bestSession?.Speed.ToString("F1") ?? "0.0")</div>
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <div class="text-uppercase text-muted small fw-bold">Chance</div>
                                                        <div class="h2 mb-0">@(bestSession?.Luck.ToString("F1") ?? "0.0")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12">
                                        <h5 class="mb-3 text-success"><i class="bi bi-journal-list"></i> Historique des 10 dernières Sessions</h5>
                                        <div class="table-responsive rounded shadow-sm">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-success">
                                                    <tr>
                                                        <th>Date de la partie</th>
                                                        <th class="text-center">Score</th>
                                                        <th class="text-center">Niveau</th>
                                                        <th class="text-center">Durée</th>
                                                        <th>Bonus (H/A/V/C)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (m_profile.LastSessions != null && m_profile.LastSessions.Any())
                                                    {
                                                        foreach (var session in m_profile.LastSessions)
                                                        {
                                                            <tr>
                                                                <td class="fw-bold">@session.PlayedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                                <td class="text-center"><span class="badge bg-info text-dark">@session.Score</span></td>
                                                                <td class="text-center">@session.LevelReached</td>
                                                                <td class="text-center">@session.Duration.ToString(@"hh\:mm\:ss")</td>
                                                                <td>
                                                                    <span class="text-muted small">
                                                                        +@session.BonusHealth / +@session.BonusAttack / +@session.BonusSpeed / +@session.BonusLuck
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="5" class="text-center py-4 text-muted italic">
                                                                <i class="bi bi-info-circle"></i> Aucune session enregistrée pour le moment. Partez à l'aventure !
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <div class="text-center my-5">
                                <div class="spinner-border text-warning" role="status"></div>
                                <p class="mt-2">Vous n'êtes pas autorisé. Redirection...</p>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
                <div class="card-footer text-center text-muted small bg-white border-top-0">
                    Système de Synchronisation Métaprogression (US 17.0)
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ProfileResponse? m_profile;
    private bool m_isLoading = true;
    private string? m_errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(authState.User.Identity?.IsAuthenticated ?? false))
        {
            Navigation.NavigateTo("login");
            return;
        }

        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        m_isLoading = true;
        m_errorMessage = null;

        try
        {
            m_profile = await Http.GetFromJsonAsync<ProfileResponse>("api/player/profile");
            Logger.LogInformation("[{Timestamp}] Profile loaded successfully for user: {User}", DateTime.UtcNow, m_profile?.Username);
        }
        catch (HttpRequestException ex)
        {
            m_errorMessage = "Impossible de charger vos statistiques pour le moment. Veuillez réessayer plus tard.";
            Logger.LogError(ex, "[{Timestamp}] HTTP Error fetching profile: {StatusCode}", DateTime.UtcNow, ex.StatusCode);
        }
        catch (Exception ex)
        {
            m_errorMessage = "Une erreur inattendue est survenue lors de la récupération du profil.";
            Logger.LogError(ex, "[{Timestamp}] Unexpected error fetching profile.", DateTime.UtcNow);
        }
        finally
        {
            m_isLoading = false;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
