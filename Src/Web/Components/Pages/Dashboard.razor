@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Web.Services
@using System.Security.Claims
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Dashboard - Island Survivor</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h3>Island Survivor - Dashboard</h3>
                    <button class="btn btn-outline-light btn-sm" @onclick="HandleLogout">Logout</button>
                </div>
                <div class="card-body">
                    <AuthorizeView>
                        <Authorized>
                            <div class="alert alert-info">
                                Hello, <strong>@context.User.Identity?.Name</strong>! Welcome to your survival dashboard.
                            </div>
                            <p>This is a protected area. You can only see this because you are logged in.</p>

                            <div class="mt-4">
                                <h5>Your Session Info</h5>
                                <ul class="list-group">
                                    <li class="list-group-item"><strong>Username:</strong> @context.User.Identity?.Name</li>
                                    <li class="list-group-item"><strong>Token:</strong> @context.User.FindFirst("SessionToken")?.Value</li>
                                </ul>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <div class="alert alert-warning">
                                You are not authorized to view this page. Redirecting to login...
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
                <div class="card-footer text-center text-muted">
                    Squelette de tableau de bord (US 17.0.1)
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(authState.User.Identity?.IsAuthenticated ?? false))
        {
            Navigation.NavigateTo("login");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
